###############################################################################
# AUTH
###############################################################################

### Register a new user (returns 200 on success, 409 if already exists)
POST http://localhost:5272/api/auth/register
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "User@123!",
  "confirmPassword": "User@123!"
}


### Register – mismatched passwords (expect 400)
POST http://localhost:5272/api/auth/register
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "User@123!",
  "confirmPassword": "WrongPassword!"
}


### Login as regular user (expect 200 + JWT)
POST http://localhost:5272/api/auth/login
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "User@123!"
}


### Login as admin (expect 200 + JWT with Admin role)
POST http://localhost:5272/api/auth/login
Content-Type: application/json

{
  "email": "admin@skillsnap.dev",
  "password": "Admin@123!"
}


### Login with wrong password (expect 401)
POST http://localhost:5272/api/auth/login
Content-Type: application/json

{
  "email": "admin@skillsnap.dev",
  "password": "WrongPassword!"
}


###############################################################################
# PORTFOLIO USERS
###############################################################################

### Get all portfolio users (public)
GET http://localhost:5272/api/portfoliousers


###############################################################################
# PROJECTS
###############################################################################

### Get all projects (public)
GET http://localhost:5272/api/projects


### Create a project as Admin (replace <admin-jwt> with token from login response)
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..N91B4zqTMSHg0WaEzDXE5kHVTUx7sIE8Wm2oppsL6X8
POST http://localhost:5272/api/projects
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
	"portfolioUserId": 1,
  "title": "New Project",
  "description": "Created via HTTP request",
  "imageUrl": "https://picsum.photos/seed/newproject/640/360"
}


### Create a project without a token (expect 401)
POST http://localhost:5272/api/projects
Content-Type: application/json

{
  "title": "Unauthorized Project",
  "description": "This should be rejected",
  "imageUrl": "https://picsum.photos/seed/unauth/640/360"
}


###############################################################################
# SKILLS
###############################################################################

### Get all skills (public)
GET http://localhost:5272/api/skills


### Create a skill as Admin (replace <admin-jwt> with token from login response)
POST http://localhost:5272/api/skills
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
	"portfolioUserId": 1,
  "name": "TypeScript",
  "level": "Intermediate"
}


### Create a skill without a token (expect 401)
POST http://localhost:5272/api/skills
Content-Type: application/json

{
  "name": "CSS",
  "level": "Beginner"
}



